{
  "name": "promptwheel",
  "version": "0.8.2",
  "description": "A deterministic, zero-LLM check for your coding loop. A win must survive a re-run from the agent's source edits alone, so a test that went green by editing the test reads GAMED. Runs in CI or a Claude Code plugin.",
  "type": "module",
  "bin": {
    "promptwheel": "bin/promptwheel.mjs"
  },
  "types": "./bin/promptwheel.d.ts",
  "exports": {
    ".": {
      "types": "./bin/promptwheel.d.ts",
      "default": "./bin/promptwheel.mjs"
    },
    "./bin/promptwheel.mjs": "./bin/promptwheel.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "packs",
    "INTEGRATE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "gate": "node bin/promptwheel.mjs run",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promptwheel-ai/promptwheel.git"
  },
  "homepage": "https://github.com/promptwheel-ai/promptwheel#readme",
  "bugs": {
    "url": "https://github.com/promptwheel-ai/promptwheel/issues"
  },
  "author": "Matthew Owens",
  "license": "Apache-2.0",
  "keywords": [
    "agent",
    "ci",
    "regression",
    "metrics",
    "verification",
    "ai-coding",
    "outcome",
    "evals",
    "loop",
    "promptwheel",
    "reward-hacking",
    "detect-gaming",
    "reward-hack-detection"
  ]
}
